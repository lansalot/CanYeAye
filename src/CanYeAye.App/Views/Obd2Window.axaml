<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CanYeAye.App.ViewModels"
        mc:Ignorable="d"
        x:Class="CanYeAye.App.Views.Obd2Window"
        x:CompileBindings="False"
        x:DataType="vm:Obd2WindowViewModel"
        Width="900" Height="620"
        Title="CanYeAye OBD-II Poller">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Bus" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Bus}" Minimum="0" Maximum="255" Width="90" />
        <TextBlock Text="Addressing" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding AddressingModes}" SelectedItem="{Binding SelectedAddressing}" Width="110" />
        <Button Content="Discover" Command="{Binding DiscoverCommand}" />
        <Button Content="Start/Stop" Command="{Binding TogglePollingCommand}" />
        <Button Content="Read VIN" Command="{Binding ReadVinCommand}" />
        <Button Content="Save DBC..." Command="{Binding SaveDbcCommand}" />
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Margin="8,4" Spacing="2">
      <TextBlock Text="{Binding Status}" FontWeight="Bold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Stats}" FontSize="11" />
    </StackPanel>

    <Grid RowDefinitions="*,140">
      <DataGrid Grid.Row="0" ItemsSource="{Binding Pids}" AutoGenerateColumns="False" IsReadOnly="True"
                HeadersVisibility="Column" GridLinesVisibility="Horizontal">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ECU" Binding="{Binding Ecu}" Width="100" />
          <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70" />
          <DataGridTextColumn Header="Signal" Binding="{Binding Name}" Width="*" />
          <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="140" />
          <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="90" />
        </DataGrid.Columns>
      </DataGrid>

      <Grid Grid.Row="1" RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="Vehicle information" FontWeight="Bold" Margin="8,4" />
        <ListBox Grid.Row="1" ItemsSource="{Binding VehicleInfo}" FontFamily="Consolas,Menlo,DejaVu Sans Mono,Courier New,monospace" />
      </Grid>
    </Grid>
  </DockPanel>
</Window>

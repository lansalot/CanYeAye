<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="CanYeAye.App.Views.NodeNameDialog"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Name J1939 node">
  <StackPanel Margin="18" Spacing="12">
    <TextBlock x:Name="AddressText" FontSize="16" FontFamily="Consolas,Menlo,DejaVu Sans Mono,Courier New,monospace" />
    <TextBox x:Name="NameBox" PlaceholderText="Node name" FontSize="15" MinHeight="36" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" Click="OnCancelClick" MinWidth="90" MinHeight="32" />
      <Button Content="OK" Click="OnOkClick" MinWidth="90" MinHeight="32" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>

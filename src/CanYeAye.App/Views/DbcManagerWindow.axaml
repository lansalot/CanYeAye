<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CanYeAye.App.ViewModels"
        mc:Ignorable="d"
        x:Class="CanYeAye.App.Views.DbcManagerWindow"
        x:CompileBindings="False"
        x:DataType="vm:DbcManagerViewModel"
        Width="820" Height="460"
        WindowStartupLocation="CenterOwner"
        Title="CanYeAye DBC Files">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Add..." Command="{Binding AddCommand}" />
        <Button Content="Remove" Command="{Binding RemoveCommand}" />
        <Separator Width="1" />
        <Button Content="Move Up" Command="{Binding MoveUpCommand}" />
        <Button Content="Move Down" Command="{Binding MoveDownCommand}" />
        <Separator Width="1" />
        <Button Content="Clear" Command="{Binding ClearCommand}" />
        <TextBlock Text="Order = lookup priority (first file wins)" VerticalAlignment="Center" Opacity="0.7" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8">
      <Button Content="Close" Click="OnCloseClick" HorizontalAlignment="Right" Width="90" />
    </Border>

    <DataGrid ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}"
              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
              GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="45" />
        <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="Messages" Binding="{Binding MessageCount}" Width="90" />
        <DataGridTextColumn Header="Signals" Binding="{Binding SignalCount}" Width="90" />
        <DataGridTextColumn Header="Path" Binding="{Binding FilePath}" Width="2*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>

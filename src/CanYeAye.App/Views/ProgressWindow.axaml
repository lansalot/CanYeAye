<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CanYeAye.App.ViewModels"
        mc:Ignorable="d"
        x:Class="CanYeAye.App.Views.ProgressWindow"
        x:CompileBindings="False"
        x:DataType="vm:MainWindowViewModel"
        Width="460" Height="150"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="CanYeAye - Loading">
  <StackPanel Margin="20" Spacing="14" VerticalAlignment="Center">
    <TextBlock Text="{Binding LoadStatus}" TextWrapping="Wrap" />
    <ProgressBar Minimum="0" Maximum="100" Value="{Binding LoadProgress}"
                 IsIndeterminate="{Binding IsLoadIndeterminate}" Height="18" />
  </StackPanel>
</Window>

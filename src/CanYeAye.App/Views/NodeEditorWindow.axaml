<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="CanYeAye.App.Views.NodeEditorWindow"
        x:CompileBindings="False"
        Width="400" Height="210"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Node Editor">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*" ColumnDefinitions="Auto,*">
    <TextBlock Grid.Row="0" Grid.Column="0" Text="Node Name:" VerticalAlignment="Center" Margin="0,6,10,6" />
    <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,4" LostFocus="OnNameLostFocus" KeyDown="OnNameKeyDown" />

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Comments:" VerticalAlignment="Center" Margin="0,6,10,6" />
    <TextBox Grid.Row="1" Grid.Column="1" x:Name="CommentBox" Margin="0,4" LostFocus="OnCommentLostFocus" />

    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Close" Width="90"
            HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="OnCloseClick" />
  </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CanYeAye.App.ViewModels"
        xmlns:controls="using:CanYeAye.App.Controls"
        mc:Ignorable="d"
        x:Class="CanYeAye.App.Views.SignalEditorWindow"
        x:CompileBindings="False"
        x:DataType="vm:SignalEditorViewModel"
        Width="1150" Height="930"
        MinWidth="900" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Title="Signal Editor">
  <Window.Styles>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,6,10,6" />
    </Style>
    <Style Selector="TextBox.field">
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="ComboBox.field">
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
  </Window.Styles>

  <Grid Margin="10" RowDefinitions="Auto,*,Auto,Auto,260" ColumnDefinitions="520,16,*">
    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
      <TextBlock Text="Name:" VerticalAlignment="Center" />
      <TextBox x:Name="NameBox" Width="430" LostFocus="OnNameLostFocus" KeyDown="OnNameKeyDown" />
    </StackPanel>

    <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1" Background="White" Margin="0,0,0,8">
      <controls:DbcBitGrid x:Name="BitGrid" BitClicked="OnBitClicked" MinHeight="480" />
    </Border>

    <TextBlock Grid.Row="2" Grid.Column="0" x:Name="BitSummary" Opacity="0.75" FontSize="11" />

    <Grid Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
          ColumnDefinitions="Auto,*" VerticalAlignment="Top">
      <TextBlock Grid.Row="0" Grid.Column="0" Classes="fieldLabel" Text="Bit Length:" />
      <TextBox Grid.Row="0" Grid.Column="1" x:Name="BitLengthBox" Classes="field" LostFocus="OnBitLengthLostFocus" KeyDown="OnBitLengthKeyDown" />

      <TextBlock Grid.Row="1" Grid.Column="0" Classes="fieldLabel" Text="Byte Order" />
      <CheckBox Grid.Row="1" Grid.Column="1" x:Name="IntelCheck" Content="LSB First (Little Endian)"
                IsCheckedChanged="OnByteOrderChanged" Margin="0,4" />

      <TextBlock Grid.Row="2" Grid.Column="0" Classes="fieldLabel" Text="Type:" />
      <ComboBox Grid.Row="2" Grid.Column="1" x:Name="TypeCombo" Classes="field" SelectionChanged="OnTypeChanged">
        <ComboBoxItem Content="UNSIGNED INTEGER" />
        <ComboBoxItem Content="SIGNED INTEGER" />
        <ComboBoxItem Content="SINGLE PRECISION" />
        <ComboBoxItem Content="DOUBLE PRECISION" />
        <ComboBoxItem Content="STRING" />
      </ComboBox>

      <TextBlock Grid.Row="3" Grid.Column="0" Classes="fieldLabel" Text="Scale:" />
      <TextBox Grid.Row="3" Grid.Column="1" x:Name="ScaleBox" Classes="field" LostFocus="OnScaleLostFocus" KeyDown="OnScaleKeyDown" />

      <TextBlock Grid.Row="4" Grid.Column="0" Classes="fieldLabel" Text="Bias:" />
      <TextBox Grid.Row="4" Grid.Column="1" x:Name="BiasBox" Classes="field" LostFocus="OnBiasLostFocus" KeyDown="OnBiasKeyDown" />

      <TextBlock Grid.Row="5" Grid.Column="0" Classes="fieldLabel" Text="Min Value:" />
      <TextBox Grid.Row="5" Grid.Column="1" x:Name="MinBox" Classes="field" LostFocus="OnMinLostFocus" KeyDown="OnMinKeyDown" />

      <TextBlock Grid.Row="6" Grid.Column="0" Classes="fieldLabel" Text="Max Value:" />
      <TextBox Grid.Row="6" Grid.Column="1" x:Name="MaxBox" Classes="field" LostFocus="OnMaxLostFocus" KeyDown="OnMaxKeyDown" />

      <TextBlock Grid.Row="7" Grid.Column="0" Classes="fieldLabel" Text="Units Name:" />
      <TextBox Grid.Row="7" Grid.Column="1" x:Name="UnitBox" Classes="field" LostFocus="OnUnitLostFocus" />

      <TextBlock Grid.Row="8" Grid.Column="0" Classes="fieldLabel" Text="Receiving Node:" />
      <ComboBox Grid.Row="8" Grid.Column="1" x:Name="ReceiverCombo" Classes="field" SelectionChanged="OnReceiverChanged" />

      <TextBlock Grid.Row="9" Grid.Column="0" Classes="fieldLabel" Text="Multiplexing" />
      <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,6">
        <RadioButton x:Name="NoneRadio" GroupName="MultiplexMode" Content="None" Tag="None" IsCheckedChanged="OnMultiplexModeChanged" />
        <RadioButton x:Name="MultiplexedRadio" GroupName="MultiplexMode" Content="Multiplexed" Tag="Multiplexed" IsCheckedChanged="OnMultiplexModeChanged" />
        <RadioButton x:Name="MultiplexorRadio" GroupName="MultiplexMode" Content="Multiplexor" Tag="Multiplexor" IsCheckedChanged="OnMultiplexModeChanged" />
        <RadioButton x:Name="ExtendedRadio" GroupName="MultiplexMode" Content="Extended" Tag="Extended" IsCheckedChanged="OnMultiplexModeChanged" />
      </StackPanel>

      <TextBlock Grid.Row="10" Grid.Column="0" Classes="fieldLabel" Text="Multiplex value" />
      <TextBox Grid.Row="10" Grid.Column="1" x:Name="MultiplexValuesBox" Classes="field"
               LostFocus="OnMultiplexValuesLostFocus" KeyDown="OnMultiplexValuesKeyDown"
               ToolTip.Tip="Separate values with semicolons, e.g. 1;2;5-7" />

      <TextBlock Grid.Row="11" Grid.Column="0" Classes="fieldLabel" Text="Multiplex Parent" />
      <ComboBox Grid.Row="11" Grid.Column="1" x:Name="MultiplexParentCombo" Classes="field" SelectionChanged="OnMultiplexParentChanged" />

      <TextBlock Grid.Row="12" Grid.Column="0" Classes="fieldLabel" Text="Comment:" />
      <TextBox Grid.Row="12" Grid.Column="1" x:Name="CommentBox" Classes="field" LostFocus="OnCommentLostFocus" />
    </Grid>

    <TextBlock Grid.Row="2" Grid.Column="2" x:Name="ErrorText" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,6,0,0" />

    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Text="Value Table:" Margin="0,10,0,4" />
    <DataGrid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" x:Name="ValueGrid"
              ItemsSource="{Binding Values}" AutoGenerateColumns="False" HeadersVisibility="Column"
              GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="True"
              CellEditEnded="OnValueCellEditEnded">
      <DataGrid.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Delete currently selected value" Click="OnDeleteValue" />
        </ContextMenu>
      </DataGrid.ContextMenu>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Value" Binding="{Binding ValueText, Mode=TwoWay}" Width="200">
          <DataGridTextColumn.Header>
            <TextBlock Text="Value">
              <TextBlock.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Show in Hex" Click="OnShowHex" />
                  <MenuItem Header="Show in Decimal" Click="OnShowDecimal" />
                </ContextMenu>
              </TextBlock.ContextMenu>
            </TextBlock>
          </DataGridTextColumn.Header>
        </DataGridTextColumn>
        <DataGridTextColumn Header="Text" Binding="{Binding Description, Mode=TwoWay}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CanYeAye.App.ViewModels"
        xmlns:controls="using:CanYeAye.App.Controls"
        mc:Ignorable="d"
        x:Class="CanYeAye.App.Views.NodeGraphWindow"
        x:CompileBindings="False"
        x:DataType="vm:NodeGraphViewModel"
        Width="1050" Height="720"
        WindowStartupLocation="CenterOwner"
        Title="J1939 Node Graph">
  <Window.Styles>
    <Style Selector="Button.top">
      <Setter Property="Padding" Value="10,3" />
    </Style>
  </Window.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8"
            Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
        <Button Grid.Column="0" Classes="top" Content="Refresh capture"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="Re-read the log / capture currently loaded in the main window." />
        <CheckBox Grid.Column="1" Content="Live" IsChecked="{Binding Live}"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Accumulate traffic as it arrives from the connected bus (starts from empty when enabled)." />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding Summary}" />
          <TextBlock Text="{Binding FramesPerSecond, StringFormat='{}{0:0} fps'}"
                     IsVisible="{Binding Live}" Opacity="0.8" />
        </StackPanel>
        <Button Grid.Column="3" Classes="top" Content="−" Click="OnZoomOutClick" MinWidth="36"
                ToolTip.Tip="Zoom out" />
        <Button Grid.Column="4" Classes="top" Content="+" Click="OnZoomInClick" MinWidth="36"
                ToolTip.Tip="Zoom in" />
        <Button Grid.Column="5" Classes="top" Content="Reset view" Click="OnRelayoutClick" />
        <Button Grid.Column="6" Classes="top" Content="Close" Click="OnCloseClick" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="10,5" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TextBlock Text="{Binding TopTalkers}" FontSize="11" Opacity="0.9" />
    </Border>

    <controls:NodeGraphControl x:Name="GraphControl"
                               Graph="{Binding Graph}"
                               Margin="6"
                               Foreground="{DynamicResource SystemBaseHighColor}"
                               Background="Transparent" />
  </DockPanel>
</Window>

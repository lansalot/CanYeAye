<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WinCAN.App.ViewModels"
             mc:Ignorable="d"
             x:Class="WinCAN.App.Views.FrameFilterView"
             x:CompileBindings="False"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.Styles>
    <Style Selector="ListBox#IdFilterList ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="2,0" />
    </Style>
    <Style Selector="ListBox#IdFilterList CheckBox">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="ListBox#NodeList ListBoxItem">
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="2,1" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="6" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
          <Button Content="Dock Left" Click="OnDockLeftClick" FontSize="11" Padding="8,3" />
          <Button Content="Dock Right" Click="OnDockRightClick" FontSize="11" Padding="8,3" />
          <Button Content="Float" Click="OnFloatClick" FontSize="11" Padding="8,3" />
          <Button Content="Full Height" Click="OnFullHeightClick" FontSize="11" Padding="8,3" />
        </StackPanel>
        <Button Grid.Column="1" Content="✕" Click="OnCloseClick" FontSize="11" Padding="8,3"
                ToolTip.Tip="Hide the frame filter" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="6" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
      <Grid ColumnDefinitions="Auto,Auto,*">
        <Button Grid.Column="0" Content="All" Command="{Binding FilterAllCommand}" Width="80" Margin="0,0,8,0" />
        <Button Grid.Column="1" Content="None" Command="{Binding FilterNoneCommand}" Width="80" Margin="0,0,8,0" />
        <TextBlock Grid.Column="2" Text="{Binding FilterSummary}" VerticalAlignment="Center" FontSize="11" />
      </Grid>
    </Border>

    <TabControl Margin="6">
      <TabItem Header="Frame IDs">
        <DockPanel>
          <TextBox DockPanel.Dock="Top" PlaceholderText="Filter IDs." Text="{Binding FilterSearch, Mode=TwoWay}"
                   Margin="0,0,0,6" />
          <ListBox x:Name="IdFilterList" ItemsSource="{Binding FrameFilters}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <TabItem Header="J1939 Nodes">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
            <TextBlock Text="Edit a node name to label the ID list and the node graph. Checking a node checks all of its IDs on the Frame IDs tab; mixed nodes show a dash."
                       TextWrapping="Wrap" FontSize="11" Opacity="0.8" />
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="All" Command="{Binding NodeFilterAllCommand}" FontSize="11" Padding="8,3" />
              <Button Content="None" Command="{Binding NodeFilterNoneCommand}" FontSize="11" Padding="8,3" />
              <Button Content="Load..." Command="{Binding LoadNodeNamesCommand}" FontSize="11" Padding="8,3" />
              <Button Content="Save..." Command="{Binding SaveNodeNamesCommand}" FontSize="11" Padding="8,3" />
              <Button Content="Reset" Command="{Binding ResetNodeNamesCommand}" FontSize="11" Padding="8,3"
                      ToolTip.Tip="Remove all node names, leaving the node list and filters unchanged." />
            </StackPanel>
          </StackPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,58,*" ColumnSpacing="6" Margin="2,0,0,3">
            <TextBlock Grid.Column="0" Text="On" FontSize="10" Opacity="0.7" />
            <TextBlock Grid.Column="1" Text="Node" FontSize="10" Opacity="0.7" />
            <TextBlock Grid.Column="2" Text="Name" FontSize="10" Opacity="0.7" />
          </Grid>
          <ListBox x:Name="NodeList" ItemsSource="{Binding NodeNameItems}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,58,*" ColumnSpacing="6">
                  <CheckBox Grid.Column="0" IsThreeState="True"
                            IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            ToolTip.Tip="Check/uncheck every ID of this node on the Frame IDs tab." />
                  <TextBlock Grid.Column="1" Text="{Binding AddressText}" VerticalAlignment="Center"
                             FontFamily="Consolas,Courier New,monospace" />
                  <TextBox Grid.Column="2" Text="{Binding Name, Mode=TwoWay}" PlaceholderText="Name" FontSize="12"
                           IsVisible="{Binding IsEditable}" />
                  <TextBlock Grid.Column="2" Text="" VerticalAlignment="Center"
                             FontSize="11" Opacity="0.7" IsVisible="{Binding !IsBroadcast}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>

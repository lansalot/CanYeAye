<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:WinCAN.App.ViewModels"
        xmlns:controls="using:WinCAN.App.Controls"
        mc:Ignorable="d"
        x:Class="WinCAN.App.Views.FrameInfoWindow"
        x:CompileBindings="False"
        x:DataType="vm:FrameInfoWindowViewModel"
        Width="1280" Height="860"
        MinWidth="940" MinHeight="660"
        WindowStartupLocation="CenterOwner"
        Title="Detailed Frame Information">
  <Window.Resources>
    <!-- Compact detail tree: the reference's tree is dense, Avalonia's default is 40px of indent per level. -->
    <x:Double x:Key="TreeViewItemIndent">4</x:Double>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="TreeViewItem">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
      <Setter Property="MinHeight" Value="19" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TreeViewItem /template/ Panel#PART_ExpandCollapseChevronContainer">
      <Setter Property="Margin" Value="3,0,4,0" />
    </Style>
    <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
      <Setter Property="Width" Value="9" />
      <Setter Property="Height" Value="9" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="6">
    <Border DockPanel.Dock="Top" Margin="0,0,0,6">
      <TextBlock Text="{Binding SnapshotText}" Classes="caption" TextTrimming="CharacterEllipsis" />
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="2,4,2,0" Margin="0,6,0,0"
            BorderThickness="1,0,0,0"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TextBlock Text="{Binding StatusText}" Classes="caption" TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid ColumnDefinitions="380,6,*">
      <!-- Left: ID list, detail tree, save button, interval histogram. -->
      <Border Grid.Column="0" Classes="panel">
        <Grid RowDefinitions="Auto,Auto,168,Auto,*,Auto,Auto,180" RowSpacing="4">
          <TextBlock Grid.Row="0" Text="Frame IDs found:" />
          <TextBlock Grid.Row="1" Text="{Binding UniqueIdText}" Classes="caption" />
          <ListBox Grid.Row="2"
                   ItemsSource="{Binding Ids}"
                   SelectedItem="{Binding SelectedIdItem, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="5,2" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock Grid.Row="3" Text="Details:" Classes="section" Margin="0,4,0,0" />
          <TreeView Grid.Row="4"
                    ItemsSource="{Binding DetailRoots}"
                    Background="Transparent"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <TreeView.ItemTemplate>
              <TreeDataTemplate ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Text}" TextWrapping="NoWrap" />
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>

          <Button Grid.Row="5"
                  Content="Save details to file"
                  Command="{Binding SaveDetailsCommand}"
                  HorizontalAlignment="Stretch"
                  IsEnabled="{Binding HasIds}" />

          <TextBlock Grid.Row="6" Text="Interval Histogram" Classes="section"
                     HorizontalAlignment="Center" Margin="0,4,0,0"
                     ToolTip.Tip="How often each inter-frame interval occurred, in milliseconds (logarithmic value axis)." />
          <controls:FrameInfoBarChart Grid.Row="7"
                                      Model="{Binding IntervalHistogram}"
                                      Foreground="{DynamicResource SystemBaseHighColor}"
                                      Background="Transparent" />
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

      <!-- Right: heatmap + bit histogram on top, per-byte value graphs below. -->
      <Border Grid.Column="2" Classes="panel">
        <Grid RowDefinitions="Auto,*,Auto,*" RowSpacing="6">
          <TextBlock Grid.Row="0" Text="{Binding SelectionText}" Classes="caption"
                     TextTrimming="CharacterEllipsis" />

          <Grid Grid.Row="1" ColumnDefinitions="400,6,*">
            <DockPanel Grid.Column="0">
              <TextBlock DockPanel.Dock="Top" Text="Heatmap" Classes="section"
                         HorizontalAlignment="Center" Margin="0,0,0,4"
                         ToolTip.Tip="How often each payload bit changes between consecutive frames of this ID." />
              <controls:FrameInfoHeatmap Model="{Binding Heatmap}"
                                         Foreground="{DynamicResource SystemBaseHighColor}"
                                         Background="Transparent" />
            </DockPanel>

            <DockPanel Grid.Column="2">
              <TextBlock DockPanel.Dock="Top" Text="Bit Histogram" Classes="section"
                         HorizontalAlignment="Center" Margin="0,0,0,4"
                         ToolTip.Tip="How many frames had each payload bit set (logarithmic value axis; bits 0-63 = byte * 8 + bit)." />
              <controls:FrameInfoBarChart Model="{Binding BitHistogram}"
                                          Foreground="{DynamicResource SystemBaseHighColor}"
                                          Background="Transparent" />
            </DockPanel>
          </Grid>

          <TextBlock Grid.Row="2" Text="Bytes Graph" Classes="section"
                     HorizontalAlignment="Center" />

          <controls:FrameInfoByteGraphs Grid.Row="3"
                                        Model="{Binding ByteGraphs}"
                                        Foreground="{DynamicResource SystemBaseHighColor}"
                                        Background="Transparent" />
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>

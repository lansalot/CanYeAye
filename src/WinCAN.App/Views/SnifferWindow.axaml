<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:WinCAN.App.ViewModels"
        mc:Ignorable="d"
        x:Class="WinCAN.App.Views.SnifferWindow"
        x:CompileBindings="False"
        x:DataType="vm:SnifferWindowViewModel"
        Width="900" Height="600"
        Title="WinCAN Sniffer">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox Content="Suspend" IsChecked="{Binding Suspended}" />
        <Button Content="Clear" Command="{Binding ClearCommand}" />
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
              HeadersVisibility="Column" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Bus" Binding="{Binding Bus}" Width="55" />
        <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="110" />
        <DataGridTextColumn Header="Ext" Binding="{Binding ExtendedText}" Width="60" />
        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="70" />
        <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="90" />
        <DataGridTextColumn Header="Rate/s" Binding="{Binding Rate}" Width="80" />
        <DataGridTextColumn Header="Data" Binding="{Binding Data}" Width="*" />
        <DataGridTextColumn Header="Last" Binding="{Binding LastSeen}" Width="130" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:WinCAN.App.ViewModels"
        xmlns:controls="using:WinCAN.App.Controls"
        mc:Ignorable="d"
        x:Class="WinCAN.App.Views.SnifferWindow"
        x:CompileBindings="False"
        x:DataType="vm:SnifferWindowViewModel"
        Width="1100" Height="750"
        WindowStartupLocation="CenterOwner"
        Title="Sniffer">
  <DockPanel Margin="6">
    <Border DockPanel.Dock="Right" Width="190" Margin="6,0,0,0" Padding="6"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="5">
          <Button Content="Notch" Command="{Binding NotchCommand}" HorizontalAlignment="Stretch"
                  ToolTip.Tip="Ignore the bits that changed during the last notch window (no longer coloured)." />
          <Button Content="Unnotch" Command="{Binding UnnotchCommand}" HorizontalAlignment="Stretch"
                  ToolTip.Tip="Clear every notched bit so all changes are coloured again." />
          <CheckBox Content="Mute notched bits" IsChecked="{Binding MuteNotchedBits}"
                    ToolTip.Tip="Notched bits never update the displayed payload." />
          <TextBlock Text="Notch Interval" HorizontalAlignment="Center" Margin="0,4,0,0" />
          <NumericUpDown Value="{Binding NotchIntervalMs}" Minimum="100" Maximum="5000"
                         Increment="10" FormatString="0 'ms'" />
          <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4" />
          <TextBlock Text="Expire Interval" HorizontalAlignment="Center" />
          <NumericUpDown Value="{Binding ExpireIntervalMs}" Minimum="1000" Maximum="100000"
                         Increment="200" FormatString="0 'ms'" />
          <CheckBox Content="Never Expire IDs" IsChecked="{Binding NeverExpireIds}" />
          <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4" />
          <TextBlock Text="Min Frequency" HorizontalAlignment="Center" />
          <NumericUpDown Value="{Binding FrequencyFilterHz}" Minimum="0" Maximum="10000"
                         Increment="1" FormatString="0 'hz'"
                         ToolTip.Tip="Drop IDs that are not seen at least this many times per second (0 = keep every ID)." />
          <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,4" />
          <CheckBox Content="Fade inactive bytes" IsChecked="{Binding FadeInactiveBytes}" />
          <CheckBox Content="View Bits" IsChecked="{Binding ViewBits}" />
        </StackPanel>

        <Grid RowDefinitions="Auto,*,Auto" Margin="0,10,0,0">
          <TextBlock Grid.Row="0" Text="Filters:" />
          <ListBox Grid.Row="1" ItemsSource="{Binding Filters}" Background="Transparent" BorderThickness="0">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="4,1" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="4">
            <Button Grid.Column="0" Content="All" Command="{Binding FilterAllCommand}"
                    HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Content="None" Command="{Binding FilterNoneCommand}"
                    HorizontalAlignment="Stretch" />
          </Grid>
        </Grid>
      </DockPanel>
    </Border>

    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
      <Grid RowDefinitions="Auto,*">
        <ScrollViewer Grid.Row="0" x:Name="HeaderScroll"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
          <controls:SnifferHeader MaxBytes="{Binding DataColumnCount}"
                                  Foreground="{DynamicResource SystemBaseHighColor}" />
        </ScrollViewer>
        <ScrollViewer Grid.Row="1" x:Name="GridScroll"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnGridScrollChanged"
                      Background="Transparent">
          <controls:SnifferGrid ItemsSource="{Binding Rows}"
                                MaxBytes="{Binding DataColumnCount}"
                                ShowBits="{Binding ViewBits}"
                                FadeInactive="{Binding FadeInactiveBytes}"
                                RefreshToken="{Binding RefreshToken}"
                                Foreground="{DynamicResource SystemBaseHighColor}"
                                Background="Transparent" />
        </ScrollViewer>
      </Grid>
    </Border>
  </DockPanel>
</Window>
